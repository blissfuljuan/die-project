# Copy to backend/.env for local development (the app imports it when started from the backend folder).
# backend/.env is git-ignored. Do not commit real credentials.

# Request development defaults. Use the DOTTED key; SPRING_PROFILES_ACTIVE written in this file is ignored.
spring.profiles.active=local

# Database (local Postgres or the docker compose one)
DB_URL=jdbc:postgresql://localhost:5432/die
DB_APP_USER=postgres
DB_APP_PASSWORD=postgres
DB_MIGRATOR_USER=postgres
DB_MIGRATOR_PASSWORD=postgres

# Email: log = print messages (with activation/reset links) to the log, smtp = real delivery.
# Do not leave this line empty ("DIE_MAIL_MODE=" counts as blank = smtp).
DIE_MAIL_MODE=log

# First administrator, created only when no admin exists. Remove after the first start.
# DIE_BOOTSTRAP_ADMIN_EMAIL=admin@school.edu
# DIE_BOOTSTRAP_ADMIN_PASSWORD=at least 12 characters
