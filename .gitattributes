# Files that run inside Linux containers or CI must have LF line endings, also in a Windows working tree
# (infra/ is bind-mounted into containers; a CR in a shell script breaks the shebang).
*.sh text eol=lf
Dockerfile* text eol=lf
*.Dockerfile text eol=lf
*.conf text eol=lf
*.py text eol=lf
render.yaml text eol=lf
.github/** text eol=lf
