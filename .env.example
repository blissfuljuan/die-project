# Copy to .env for local development. Never commit .env.
# --- Postgres (local dev only; production uses Supabase Postgres) ---
POSTGRES_DB=die
POSTGRES_MIGRATOR_USER=die_migrator
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator
POSTGRES_APP_USER=die_app
POSTGRES_APP_PASSWORD=change-me-app
# --- RabbitMQ ---
RABBITMQ_USER=die
RABBITMQ_PASSWORD=change-me-rabbit
# --- AI provider (placeholder; configured per task in the admin UI later) ---
AI_PROVIDER_API_KEY=
# --- First administrator for `docker compose up` + scripts/smoke.sh (created only when no admin exists; password >= 12 characters) ---
DIE_BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
DIE_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
# --- Host ports (container ports never change); move them when something else holds a port ---
# POSTGRES_HOST_PORT=5432
# RABBITMQ_AMQP_HOST_PORT=5672
# RABBITMQ_MGMT_HOST_PORT=15672
# API_HOST_PORT=8080
# FRONTEND_HOST_PORT=5173
